# Auto-detect text files and normalize line endings
* text=auto

# Code and config files use LF in repo
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Windows scripts must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files untouched
*.png binary
*.jpg binary
*.jpeg binary
*.mp4 binary
*.avi binary
*.onnx binary
*.pt binary
